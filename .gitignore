# Веса моделей — десятки гигабайт, качаются заново на целевой машине.
models/

# Симлинки на модели: путь зависит от того, что реально скачано локально,
# run-mlx.sh пересоздаёт их сам при каждом запуске (ln -sfn).
gemma-e4b
gemma-12b

# Виртуальное окружение MLX — ставится заново (requirements ниже).
.venv-mlx/

# Вендоренный апстрим llama.cpp: отдельный git-репозиторий (origin
# ggml-org/llama.cpp), не сабмодуль. Клонировать и собирать отдельно —
# см. раздел "Сборка llama.cpp" в CLAUDE.md.
llama.cpp/

# Старый бэкап собранных бинарников — не исходники, пересобирается.
llama-bin-bak-*/

# Локальная память Claude Code для этого проекта.
.remember/

