# Model weights — tens of gigabytes, redownloaded on the target machine.
models/

# Symlinks to models: the path depends on what's actually downloaded
# locally, run-mlx.sh recreates them on every launch (ln -sfn).
gemma-e4b
gemma-12b

# MLX virtual environment — reinstalled from scratch (see requirements below).
.venv-mlx/

# Vendored llama.cpp upstream: a separate git repository (origin
# ggml-org/llama.cpp), not a submodule. Clone and build it separately —
# see the "Building llama.cpp" section in CLAUDE.md.
llama.cpp/

# Old backup of built binaries — not source, rebuilt on demand.
llama-bin-bak-*/

# Claude Code's local memory for this project.
.remember/

.DS_Store
